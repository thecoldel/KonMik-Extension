<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Konmik's Extension Library</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

        :root {
            --bg-color: #09090b;
            --card-bg: #121214;
            --card-border: rgba(255, 255, 255, 0.07);
            --card-hover-border: rgba(255, 122, 0, 0.4);
            --text-main: #f4f4f5;
            --text-muted: #a1a1aa;
            --accent: #FF7A00;
            --accent-glow: rgba(255, 122, 0, 0.15);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Plus Jakarta Sans', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            line-height: 1.5;
        }

        /* Header & Navbar */
        header {
            background-color: rgba(18, 18, 20, 0.8);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--card-border);
            position: sticky;
            top: 0;
            z-index: 50;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 0 20px;
            width: 100%;
        }

        .navbar {
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-icon {
            width: 38px;
            height: 38px;
            background: var(--accent-glow);
            border: 1px solid rgba(255, 122, 0, 0.3);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent);
            font-size: 16px;
        }

        .brand-title {
            font-size: 14px;
            font-weight: 700;
            letter-spacing: -0.01em;
        }

        .brand-subtitle {
            font-size: 11px;
            color: var(--text-muted);
        }

        .json-link {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--card-border);
            color: var(--text-muted);
            padding: 7px 12px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .json-link:hover {
            background: rgba(255, 255, 255, 0.06);
            color: var(--text-main);
            border-color: rgba(255, 255, 255, 0.15);
        }

        /* Main Content */
        main {
            flex: 1;
            padding: 40px 20px;
            max-width: 900px;
            margin: 0 auto;
            width: 100%;
        }

        .hero {
            display: flex;
            flex-direction: column;
            gap: 16px;
            margin-bottom: 32px;
        }

        @media(min-width: 640px) {
            .hero {
                flex-direction: row;
                align-items: center;
                justify-content: space-between;
            }
        }

        .hero h2 {
            font-size: 22px;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .hero p {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 2px;
        }

        .search-box input {
            width: 100%;
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            padding: 11px 16px;
            border-radius: 10px;
            color: var(--text-main);
            font-size: 13px;
            font-family: inherit;
            outline: none;
            transition: all 0.2s ease;
        }

        @media(min-width: 640px) {
            .search-box input {
                width: 250px;
            }
        }

        .search-box input:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-glow);
        }

        /* Grid & Kartu Ekstensi */
        .extension-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 14px;
        }

        @media(min-width: 640px) {
            .extension-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        .ext-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 14px;
            padding: 18px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 16px;
            transition: all 0.2s ease;
        }

        .ext-card:hover {
            border-color: var(--card-hover-border);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
        }

        .ext-header {
            display: flex;
            gap: 14px;
            align-items: flex-start;
        }

        .ext-icon {
            width: 48px;
            height: 48px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--card-border);
            object-fit: cover;
            padding: 3px;
            flex-shrink: 0;
        }

        .ext-info h3 {
            font-size: 14px;
            font-weight: 600;
            letter-spacing: -0.01em;
            margin-bottom: 2px;
        }

        .ext-meta {
            font-size: 12px;
            color: var(--text-muted);
        }

        .ext-meta span {
            color: var(--text-main);
            font-weight: 500;
        }

        .ext-badges {
            display: flex;
            gap: 6px;
            margin-top: 6px;
            align-items: center;
        }

        .badge-lang {
            background: var(--accent-glow);
            color: var(--accent);
            border: 1px solid rgba(255, 122, 0, 0.2);
            font-size: 9px;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 4px;
            text-transform: uppercase;
        }

        .badge-version {
            background: rgba(255, 255, 255, 0.04);
            color: var(--text-muted);
            font-size: 10px;
            font-family: monospace;
            padding: 2px 6px;
            border-radius: 4px;
        }

        /* Tombol Aksi */
        .ext-actions {
            display: flex;
            gap: 8px;
            padding-top: 12px;
            border-top: 1px solid var(--card-border);
        }

        .btn {
            flex: 1;
            padding: 9px 12px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 600;
            text-align: center;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s ease;
            border: none;
            font-family: inherit;
        }

        .btn-copy {
            background: rgba(255, 255, 255, 0.03);
            color: var(--text-muted);
            border: 1px solid var(--card-border);
        }

        .btn-copy:hover {
            background: rgba(255, 255, 255, 0.07);
            color: var(--text-main);
        }

        .btn-install {
            background: var(--accent);
            color: #ffffff;
            box-shadow: 0 4px 12px var(--accent-glow);
        }

        .btn-install:hover {
            opacity: 0.9;
        }

        .empty-state {
            text-align: center;
            padding: 50px 20px;
            color: var(--text-muted);
            font-size: 13px;
            grid-column: 1 / -1;
        }

        /* Footer */
        footer {
            border-top: 1px solid var(--card-border);
            padding: 24px 0;
            text-align: center;
            font-size: 11px;
            color: var(--text-muted);
        }
    </style>
</head>
<body>
    
    <!-- Header -->
    <header>
        <div class="container navbar">
            <div class="brand">
                <div class="brand-icon">⚡</div>
                <div>
                    <h1 class="brand-title">Konmik's Extension Library</h1>
                    <p class="brand-subtitle">Koleksi repositori ekstensi</p>
                </div>
            </div>
            <a href="index.json" target="_blank" class="json-link">index.json ↗</a>
        </div>
    </header>

    <!-- Main Content -->
    <main>
        <div class="hero">
            <div>
                <h2>Daftar Ekstensi</h2>
                <p>Pasang ekstensi pilihan Anda ke aplikasi dengan mudah.</p>
            </div>
            <div class="search-box">
                <input type="text" id="search-input" placeholder="Cari ekstensi...">
            </div>
        </div>

        <div id="extension-grid" class="extension-grid">
            <!-- Data dimuat otomatis via JavaScript -->
        </div>
    </main>

    <!-- Footer -->
    <footer>
        <p>© 2026 • Didukung oleh GitHub & Vercel</p>
    </footer>

    <!-- Script JavaScript -->
    <script>
        let allExtensions = [];

        async function loadExtensions() {
            try {
                const response = await fetch('index.json');
                allExtensions = await response.json();
                renderExtensions(allExtensions);
            } catch (error) {
                console.error('Gagal memuat index.json:', error);
                document.getElementById('extension-grid').innerHTML = `
                    <div class="empty-state" style="color: #ef4444;">
                        Gagal memuat index.json. Pastikan filenya sudah ada di repository!
                    </div>
                `;
            }
        }

        function renderExtensions(extensions) {
            const grid = document.getElementById('extension-grid');
            grid.innerHTML = '';

            if (extensions.length === 0) {
                grid.innerHTML = `<div class="empty-state">Ekstensi tidak ditemukan.</div>`;
                return;
            }

            const rawRepoUrl = window.location.href.replace(/\/[^/]*$/, '/');

            extensions.forEach(ext => {
                const fileUrl = rawRepoUrl + ext.file;

                grid.innerHTML += `
                    <div class="ext-card">
                        <div class="ext-header">
                            <img src="${ext.icon}" alt="${ext.name}" class="ext-icon">
                            <div style="min-width: 0; flex: 1;">
                                <h3 style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${ext.name}</h3>
                                <p class="ext-meta">Oleh: <span>${ext.author}</span></p>
                                <div class="ext-badges">
                                    <span class="badge-lang">${ext.lang}</span>
                                    <span class="badge-version">v${ext.version}</span>
                                </div>
                            </div>
                        </div>

                        <div class="ext-actions">
                            <button onclick="navigator.clipboard.writeText('${fileUrl}'); alert('Link URL berhasil disalin!');" class="btn btn-copy">
                                Salin Link
                            </button>
                            <a href="${fileUrl}" target="_blank" class="btn btn-install">
                                Install ⚡
                            </a>
                        </div>
                    </div>
                `;
            });
        }

        document.getElementById('search-input').addEventListener('input', (e) => {
            const keyword = e.target.value.toLowerCase();
            const filtered = allExtensions.filter(ext => 
                ext.name.toLowerCase().includes(keyword) || 
                ext.author.toLowerCase().includes(keyword)
            );
            renderExtensions(filtered);
        });

        loadExtensions();
    </script>
</body>
</html>
